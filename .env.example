# ═══════════════════════════════════════════════════
#  GALIA BELLEZA - Variables de Entorno
#  Copia este archivo como .env y rellena los valores
# ═══════════════════════════════════════════════════

# ─── OBLIGATORIO ────────────────────────────────────
# Tu API Key de OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto del servidor (por defecto 3000)
PORT=3000

# ─── SEGURIDAD PANEL ────────────────────────────────
# Clave para proteger el endpoint /leads (opcional pero recomendado)
# Si la configuras, añade el header: x-api-key: tu_clave
ADMIN_API_KEY=galia_admin_2025_xxxx

# ─── NOTIFICACIONES (opcional, activar cuando quieras) ──

# Make / Zapier / n8n webhook para notificar a Eva y Nuria
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxx

# Telegram Bot (para recibir notificaciones instantáneas)
# TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ─── WHATSAPP (cuando estés lista para conectar) ─────
# WhatsApp Cloud API (Meta)
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxx
# WHATSAPP_VERIFY_TOKEN=galia_verify_xxxx

# Twilio WhatsApp
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=+14155238886
